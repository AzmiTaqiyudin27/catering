# Database Connection (Neon DB / PostgreSQL)
# Contoh Neon DB pooled connection (disarankan untuk Vercel Serverless):
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://username:password@ep-your-neon-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="ganti-dengan-kunci-rahasia-yang-panjang-dan-acak-di-produksi"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="production"

# Supabase Storage Configuration (Penyimpanan gambar Menu, Karyawan, Avatar di Cloud)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# Opsional: Service role key jika bucket berstatus private
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Nama storage bucket di Supabase (Pastikan bucket 'catering' diset Public di dashboard Supabase)
SUPABASE_BUCKET="catering"

# File Upload Limits (dalam bytes, default 5MB)
MAX_FILE_SIZE=5242880
