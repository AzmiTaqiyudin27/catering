{
  "name": "catering-management-system",
  "version": "1.0.0",
  "description": "Fullstack Catering Management System",
  "private": true,
  "scripts": {
    "build:backend": "npm --prefix backend run prisma:generate",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node backend/src/index.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "db:push": "npm --prefix backend run db:push",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0"
  }
}
